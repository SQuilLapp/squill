<Project>
  <Import Project="$(MSBuildThisFileDirectory)eng/Version.props" />
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <!-- -p:Version=... on the command line still wins (global properties are not overridden). -->
    <Version>$(SquillVersion)</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>SQuilL</Product>
    <Company>SQuilL</Company>
    <Authors>SQuilL</Authors>
    <Copyright>Copyright (c) SQuilL contributors</Copyright>
  </PropertyGroup>
  <!-- Libraries must stay AOT-compatible (IL2xxx/IL3xxx become errors via TreatWarningsAsErrors). -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <!-- XML docs (CS1591) are required on libraries only: tests and executables expose no API. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests')) And !$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)tools'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- Machine-specific settings (for example LoomEditorPath); git-ignored. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
</Project>
