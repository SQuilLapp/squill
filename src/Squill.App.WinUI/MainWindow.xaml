<Window x:Class="Squill.App.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Squill.App.WinUI.Views"
        Title="SQuilL">
  <Grid x:Name="Root" Background="{ThemeResource SquillBgBaseBrush}" KeyboardAcceleratorPlacementMode="Hidden">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="F5" Invoked="OnRunAccelerator" />
      <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnRunAccelerator" />
      <KeyboardAccelerator Key="Escape" Invoked="OnCancelAccelerator" />
      <KeyboardAccelerator Key="F" Modifiers="Control,Shift" Invoked="OnFormatAccelerator" />
      <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnNewTabAccelerator" />
      <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnCloseTabAccelerator" />
      <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnApplyDesignerAccelerator" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="41" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="45" />
      <ColumnDefinition Width="270" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Border x:Name="TitleBar" Grid.ColumnSpan="5" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" HorizontalAlignment="Left">
          <Image x:Name="TitleIcon" Width="16" Height="16" Margin="0,0,8,0" />
          <MenuBar x:Name="MainMenu" VerticalAlignment="Center">
            <MenuBar.Resources>
              <Thickness x:Key="MenuBarItemMargin">0</Thickness>
              <Thickness x:Key="MenuBarItemButtonPadding">4,0</Thickness>
            </MenuBar.Resources>
          </MenuBar>
        </StackPanel>
        <Border x:Name="CommandSearch" Width="438" Height="27" CornerRadius="6" BorderThickness="1" Padding="8,0"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel x:Name="CommandSearchRow" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="CommandSearchText" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
            <ContentControl Grid.Column="1" Content="Ctrl+K" Style="{StaticResource KeyboardChipStyle}" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Border x:Name="ActivityRail" Grid.Row="1" BorderThickness="0,0,1,0">
      <Grid>
        <StackPanel Spacing="4" Margin="0,4,0,0" VerticalAlignment="Top">
          <Grid>
            <Rectangle x:Name="BarExplorer" Width="3" Height="24" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" />
            <Button x:Name="RailExplorer" Style="{StaticResource RailButtonStyle}" HorizontalAlignment="Center" />
          </Grid>
          <Grid>
            <Rectangle x:Name="BarHistory" Width="3" Height="24" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" />
            <Button x:Name="RailHistory" Style="{StaticResource RailButtonStyle}" HorizontalAlignment="Center" />
          </Grid>
          <Grid>
            <Rectangle x:Name="BarSnippets" Width="3" Height="24" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" />
            <Button x:Name="RailSnippets" Style="{StaticResource RailButtonStyle}" HorizontalAlignment="Center" />
          </Grid>
          <Button x:Name="RailDiagram" Style="{StaticResource RailButtonStyle}" HorizontalAlignment="Center" Click="OnDiagramClicked" />
        </StackPanel>
        <Button x:Name="RailSettings" Style="{StaticResource RailButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,8" Click="OnSettingsClicked" />
      </Grid>
    </Border>
    <v:SidebarView x:Name="Sidebar" Grid.Row="1" Grid.Column="1" />
    <Grid Grid.Row="1" Grid.Column="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border x:Name="TabStripBar" Height="36" BorderThickness="0,0,0,1">
        <TabView x:Name="Tabs" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent" Background="Transparent"
                 TabCloseRequested="OnTabCloseRequested" SelectionChanged="OnTabSelectionChanged">
          <TabView.TabStripFooter>
            <Button x:Name="NewTabButton" Style="{StaticResource IconButtonStyle}" Width="36" Height="35" CornerRadius="0" Click="OnNewTabClicked">
              <Viewbox Width="14" Height="14">
                <Canvas Width="24" Height="24">
                  <Path Data="M12,5 V19 M5,12 H19" Stroke="{ThemeResource SquillFg2Brush}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                </Canvas>
              </Viewbox>
            </Button>
          </TabView.TabStripFooter>
        </TabView>
      </Border>
      <v:QueryTabView x:Name="ActiveTabView" Grid.Row="1" />
      <v:DiagramTabView x:Name="DiagramArea" Grid.Row="1" Visibility="Collapsed" />
      <v:TableDesignerView x:Name="DesignerArea" Grid.Row="1" Visibility="Collapsed" />
      <Grid x:Name="TerminalArea" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
    <v:PropertiesPanel x:Name="Properties" Grid.Row="1" Grid.Column="4" />
    <v:StatusBar x:Name="Status" Grid.Row="2" Grid.ColumnSpan="5" />
  </Grid>
</Window>
