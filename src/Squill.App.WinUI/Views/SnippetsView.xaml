<UserControl x:Class="Squill.App.WinUI.Views.SnippetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="using:Squill.Platform.Storage">
  <Grid RowDefinitions="Auto,*">
    <Button x:Name="SaveButton" Margin="8" HorizontalAlignment="Stretch" Click="OnSaveClicked" />
    <ListView x:Name="List" Grid.Row="1" SelectionMode="Single" DoubleTapped="OnDoubleTapped">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="st:Snippet">
          <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource SquillFgBrush}" />
        </DataTemplate>
      </ListView.ItemTemplate>
      <ListView.ContextFlyout>
        <MenuFlyout>
          <MenuFlyoutItem x:Name="InsertItem" Click="OnInsertClicked" />
          <MenuFlyoutItem x:Name="RenameItem" Click="OnRenameClicked" />
          <MenuFlyoutItem x:Name="DeleteItem" Click="OnDeleteClicked" />
        </MenuFlyout>
      </ListView.ContextFlyout>
    </ListView>
  </Grid>
</UserControl>
