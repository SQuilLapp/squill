<Window x:Class="Squill.App.WinUI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Squill.App.WinUI.Localization">
  <Grid x:Name="Root" Background="{ThemeResource SquillBgBaseBrush}" RowDefinitions="Auto,*" ColumnDefinitions="260,*">
    <Grid.Resources>
      <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SquillFontSizeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SquillFgBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
      <Style x:Key="RowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SquillFontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SquillFgBrush}" />
      </Style>
      <Style x:Key="RowDescStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SquillFontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource SquillFg3Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SquillBgRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SquillBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SquillRadiusLg}" />
      </Style>
      <Style x:Key="NavItemStyle" TargetType="RadioButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="NavRoot" Height="36" CornerRadius="{StaticResource SquillRadiusMd}" Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="NavRoot.Background" Value="{ThemeResource SquillBgHoverBrush}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="NavRoot.Background" Value="{ThemeResource SquillBgActiveBrush}" /></VisualState.Setters></VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Unchecked" />
                    <VisualState x:Name="Checked">
                      <VisualState.Setters>
                        <Setter Target="NavRoot.Background" Value="{ThemeResource SquillBgActiveBrush}" />
                        <Setter Target="NavBar.Background" Value="{ThemeResource SquillAccentBrush}" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid ColumnDefinitions="3,*">
                  <Border x:Name="NavBar" Width="3" Margin="0,6" CornerRadius="2" Background="Transparent" />
                  <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Margin="9,0" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ThemeCardStyle" TargetType="RadioButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="CardRoot" BorderThickness="1" BorderBrush="{ThemeResource SquillBorderBrush}"
                      CornerRadius="{StaticResource SquillRadiusLg}" Background="{ThemeResource SquillBgRaisedBrush}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Unchecked" />
                    <VisualState x:Name="Checked">
                      <VisualState.Setters>
                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource SquillAccentBrush}" />
                        <Setter Target="CardRoot.BorderThickness" Value="2" />
                        <Setter Target="Dot.Stroke" Value="{ThemeResource SquillAccentBrush}" />
                        <Setter Target="Dot.Fill" Value="{ThemeResource SquillAccentBrush}" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <StackPanel>
                  <ContentPresenter Content="{TemplateBinding Tag}" Height="96" CornerRadius="7,7,0,0" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" Height="40">
                    <Ellipse x:Name="Dot" Width="16" Height="16" VerticalAlignment="Center" StrokeThickness="1.5"
                             Stroke="{ThemeResource SquillFg3Brush}" Fill="Transparent" />
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PreviewBarStyle" TargetType="Border">
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
      </Style>
      <Style x:Key="PreviewButtonStyle" TargetType="Border">
        <Setter Property="Height" Value="14" />
        <Setter Property="Width" Value="50" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,22,0,0" />
      </Style>
    </Grid.Resources>

    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="8,6">
      <Button x:Name="BackButton" Style="{StaticResource IconButtonStyle}" Click="OnBack" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="24,8,16,16" Spacing="4">
      <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItemStyle}" GroupName="Nav" Checked="OnNavChecked" />
      <RadioButton x:Name="NavEditor" Style="{StaticResource NavItemStyle}" GroupName="Nav" Checked="OnNavChecked" />
      <RadioButton x:Name="NavGrid" Style="{StaticResource NavItemStyle}" GroupName="Nav" Checked="OnNavChecked" />
      <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavItemStyle}" GroupName="Nav" Checked="OnNavChecked" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="0,0,40,32" MaxWidth="860" HorizontalAlignment="Left">
        <StackPanel x:Name="PageAppearance" Spacing="12">
          <TextBlock Style="{StaticResource PageTitleStyle}" loc:Loc.Key="settings.appearance" />
          <Border Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel Spacing="14">
              <StackPanel>
                <TextBlock Style="{StaticResource RowTitleStyle}" loc:Loc.Key="settings.themeTitle" />
                <TextBlock Style="{StaticResource RowDescStyle}" loc:Loc.Key="settings.themeDesc" />
              </StackPanel>
              <Grid ColumnDefinitions="*,12,*,12,*">
                <RadioButton x:Name="ThemeSystem" Style="{StaticResource ThemeCardStyle}" GroupName="Theme" Checked="OnThemeChecked" loc:Loc.Key="settings.themeSystem">
                  <RadioButton.Tag>
                    <Grid ColumnDefinitions="*,*">
                      <Border Background="#F4F5F9" Padding="12"><StackPanel Spacing="6"><Border Style="{StaticResource PreviewBarStyle}" Width="70" Background="#D6D8E0" /><Border Style="{StaticResource PreviewBarStyle}" Width="40" Background="#D6D8E0" /><Border Style="{StaticResource PreviewButtonStyle}" Background="#5B4FD6" /></StackPanel></Border>
                      <Border Grid.Column="1" Background="#17171C" Padding="12"><StackPanel Spacing="6"><Border Style="{StaticResource PreviewBarStyle}" Width="70" Background="#3A3C47" /><Border Style="{StaticResource PreviewBarStyle}" Width="40" Background="#3A3C47" /><Border Style="{StaticResource PreviewButtonStyle}" Background="#8478F0" /></StackPanel></Border>
                    </Grid>
                  </RadioButton.Tag>
                </RadioButton>
                <RadioButton x:Name="ThemeLight" Grid.Column="2" Style="{StaticResource ThemeCardStyle}" GroupName="Theme" Checked="OnThemeChecked" loc:Loc.Key="settings.themeLight">
                  <RadioButton.Tag>
                    <Border Background="#F4F5F9" Padding="12"><StackPanel Spacing="6"><Border Style="{StaticResource PreviewBarStyle}" Width="70" Background="#D6D8E0" /><Border Style="{StaticResource PreviewBarStyle}" Width="40" Background="#D6D8E0" /><Border Style="{StaticResource PreviewButtonStyle}" Background="#5B4FD6" /></StackPanel></Border>
                  </RadioButton.Tag>
                </RadioButton>
                <RadioButton x:Name="ThemeDark" Grid.Column="4" Style="{StaticResource ThemeCardStyle}" GroupName="Theme" Checked="OnThemeChecked" loc:Loc.Key="settings.themeDark">
                  <RadioButton.Tag>
                    <Border Background="#17171C" Padding="12"><StackPanel Spacing="6"><Border Style="{StaticResource PreviewBarStyle}" Width="70" Background="#3A3C47" /><Border Style="{StaticResource PreviewBarStyle}" Width="40" Background="#3A3C47" /><Border Style="{StaticResource PreviewButtonStyle}" Background="#8478F0" /></StackPanel></Border>
                  </RadioButton.Tag>
                </RadioButton>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="PageEditor" Spacing="12" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitleStyle}" loc:Loc.Key="settings.editor" />
          <Border Style="{StaticResource CardStyle}">
            <Grid MinHeight="56" ColumnDefinitions="*,Auto" Margin="20,10" ColumnSpacing="16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitleStyle}" loc:Loc.Key="settings.fontSizeTitle" />
                <TextBlock Style="{StaticResource RowDescStyle}" loc:Loc.Key="settings.fontSizeDesc" />
              </StackPanel>
              <NumberBox x:Name="FontSizeBox" Grid.Column="1" Width="140" VerticalAlignment="Center" Minimum="8" Maximum="32" SmallChange="1"
                         SpinButtonPlacementMode="Inline" ValueChanged="OnFontSizeChanged" />
            </Grid>
          </Border>
          <Border Style="{StaticResource CardStyle}">
            <StackPanel Margin="20,14,20,10">
              <TextBlock Style="{StaticResource RowTitleStyle}" loc:Loc.Key="settings.formatting" />
              <Grid MinHeight="56" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Foreground="{ThemeResource SquillFgBrush}" loc:Loc.Key="settings.keywordCaseTitle" />
                  <TextBlock Style="{StaticResource RowDescStyle}" loc:Loc.Key="settings.keywordCaseDesc" />
                </StackPanel>
                <ComboBox x:Name="KeywordCaseBox" Grid.Column="1" Width="180" VerticalAlignment="Center" SelectionChanged="OnKeywordCaseChanged" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="PageGrid" Spacing="12" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitleStyle}" loc:Loc.Key="settings.grid" />
          <Border Style="{StaticResource CardStyle}">
            <Grid MinHeight="56" ColumnDefinitions="*,Auto" Margin="20,10" ColumnSpacing="16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitleStyle}" loc:Loc.Key="settings.maxRowsTitle" />
                <TextBlock Style="{StaticResource RowDescStyle}" loc:Loc.Key="settings.maxRowsDesc" />
              </StackPanel>
              <NumberBox x:Name="MaxRowsBox" Grid.Column="1" Width="180" VerticalAlignment="Center" Minimum="1000" Maximum="10000000" SmallChange="1000"
                         SpinButtonPlacementMode="Inline" ValueChanged="OnMaxRowsChanged" />
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel x:Name="PageAdvanced" Spacing="12" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitleStyle}" loc:Loc.Key="settings.advanced" />
          <Border Style="{StaticResource CardStyle}">
            <Grid MinHeight="56" ColumnDefinitions="*,Auto" Margin="20,10" ColumnSpacing="16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitleStyle}" loc:Loc.Key="settings.dataFolderTitle" />
                <TextBlock Style="{StaticResource RowDescStyle}" loc:Loc.Key="settings.dataFolderDesc" />
                <TextBlock x:Name="DataFolderPath" Style="{StaticResource MonoTextBlockStyle}" FontSize="{StaticResource SquillFontSizeBodySm}"
                           Foreground="{ThemeResource SquillFg2Brush}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
              <Button x:Name="OpenDataFolderButton" Grid.Column="1" VerticalAlignment="Center" Click="OnOpenDataFolder" loc:Loc.Key="menu.openDataFolder" />
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
