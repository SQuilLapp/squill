<UserControl x:Class="Squill.App.WinUI.Views.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Squill.App.WinUI.Views"
             Visibility="Collapsed">
  <Border Background="{ThemeResource SquillBgSurfaceBrush}" BorderBrush="{ThemeResource SquillBorderSubtleBrush}" BorderThickness="1,0,0,0">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock x:Name="TitleText" Style="{StaticResource CapsTextBlockStyle}" Margin="14,12,14,8" />
      <ScrollViewer Grid.Row="1">
        <StackPanel Margin="14,0,14,8" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Viewbox Width="16" Height="16">
              <Canvas Width="24" Height="24">
                <Path x:Name="TableIcon" Data="M4,5 H20 V19 H4 Z M4,10 H20 M4,15 H20 M10,5 V19" Stroke="{ThemeResource SquillAccentTextBrush}"
                      StrokeThickness="1.5" StrokeLineJoin="Round" />
                <Path x:Name="ViewIcon" Data="M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9 Z"
                      Stroke="{ThemeResource SquillInfoBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Visibility="Collapsed" />
              </Canvas>
            </Viewbox>
            <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SquillFgBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock x:Name="SubtitleText" Foreground="{ThemeResource SquillFg3Brush}" Margin="0,0,0,12" />
          <TextBlock x:Name="ColumnsHeader" Style="{StaticResource CapsTextBlockStyle}" Margin="0,4,0,4" />
          <ItemsControl x:Name="ColumnList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="v:ColumnRow">
                <Grid Height="24" ColumnDefinitions="16,*,Auto">
                  <TextBlock Text="◆" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource SquillAccentBrush}"
                             Visibility="{x:Bind v:ExplorerGlyphs.Show(IsPrimaryKey)}" />
                  <TextBlock Text="→" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource SquillInfoBrush}"
                             Visibility="{x:Bind v:ExplorerGlyphs.Show(IsForeignOnly)}" />
                  <TextBlock Text="·" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource SquillFg3Brush}"
                             Visibility="{x:Bind v:ExplorerGlyphs.Show(IsPlain)}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MonoTextBlockStyle}" Text="{x:Bind Name}" Foreground="{ThemeResource SquillFgBrush}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Style="{StaticResource MonoTextBlockStyle}" Text="{x:Bind DataType}" Foreground="{ThemeResource SquillFg3Brush}"
                             Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="IndexesHeader" Style="{StaticResource CapsTextBlockStyle}" Margin="0,12,0,4" />
          <ItemsControl x:Name="IndexList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Style="{StaticResource MonoTextBlockStyle}" Text="{x:Bind}" Height="24" Foreground="{ThemeResource SquillFgBrush}"
                           TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <Button x:Name="OpenDesigner" Grid.Row="2" Style="{StaticResource GhostButtonStyle}" Margin="8,4,8,8" HorizontalAlignment="Left"
              Foreground="{ThemeResource SquillAccentTextBrush}" Click="OnOpenDesignerClicked">
        <TextBlock x:Name="OpenDesignerText" Foreground="{ThemeResource SquillAccentTextBrush}" />
      </Button>
    </Grid>
  </Border>
</UserControl>
