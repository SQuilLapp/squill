<Window x:Class="Squill.App.WinUI.Views.ConnectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Squill.App.WinUI.Localization">
  <Grid x:Name="Root" Background="{ThemeResource SquillBgBaseBrush}" ColumnDefinitions="292,*">
    <Grid.Resources>
      <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SquillFontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource SquillFg2Brush}" />
      </Style>
      <Style x:Key="FieldBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Height" Value="30" />
      </Style>
    </Grid.Resources>

    <Border Background="{ThemeResource SquillBgSurfaceBrush}" BorderBrush="{ThemeResource SquillBorderSubtleBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*">
        <Grid Margin="12,12,12,8">
          <Button x:Name="NewButton" HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Width="27" Height="27" Click="OnNewConnection">
            <Viewbox Width="14" Height="14">
              <Canvas Width="24" Height="24">
                <Path Data="M12,5 V19 M5,12 H19" Stroke="{ThemeResource SquillFg2Brush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Canvas>
            </Viewbox>
          </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ListHost" Margin="12,0,12,12" Spacing="2" />
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="*,Auto">
      <ScrollViewer>
        <Grid Margin="32" ColumnDefinitions="*,32,339" RowDefinitions="Auto,24,Auto,24,Auto,Auto,Auto">
          <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="14">
            <ContentControl x:Name="HeaderEngine" Width="32" Height="32" FontSize="13" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="HeaderName" FontSize="{StaticResource SquillFontSizeTitle}" FontWeight="SemiBold" Foreground="{ThemeResource SquillFgBrush}" />
              <TextBlock x:Name="HeaderSubtitle" FontSize="{StaticResource SquillFontSizeBody}" Foreground="{ThemeResource SquillFg3Brush}" loc:Loc.Key="connections.newUnsaved" />
            </StackPanel>
            <ContentControl x:Name="HeaderEnv" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Style="{StaticResource CapsTextBlockStyle}" loc:Loc.Key="connections.engine" />
            <Grid x:Name="EngineHost" ColumnDefinitions="*,*,*,*" ColumnSpacing="7" />
          </StackPanel>

          <StackPanel Grid.Row="2" Grid.Column="2" Spacing="8">
            <TextBlock Style="{StaticResource CapsTextBlockStyle}" loc:Loc.Key="connections.environment" />
            <Grid x:Name="EnvironmentHost" ColumnDefinitions="*,*" RowDefinitions="34,34" ColumnSpacing="7" RowSpacing="7" />
            <TextBlock x:Name="ProductionHint" FontSize="{StaticResource SquillFontSizeBodySm}" TextWrapping="Wrap" Foreground="{ThemeResource SquillFg3Brush}"
                       loc:Loc.Key="connections.productionHint" />
          </StackPanel>

          <SelectorBar x:Name="Tabs" Grid.Row="4" SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Name="GeneralTabItem" IsSelected="True" />
            <SelectorBarItem x:Name="SshTabItem" />
          </SelectorBar>

          <StackPanel x:Name="GeneralTab" Grid.Row="5" Spacing="14" Margin="0,16,0,0">
            <Grid ColumnDefinitions="*,16,220">
              <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.name" />
                <TextBox x:Name="NameBox" Style="{StaticResource FieldBoxStyle}" TextChanged="OnNameChanged" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.folder" />
                <ComboBox x:Name="FolderBox" IsEditable="True" HorizontalAlignment="Stretch" MinHeight="30" TextSubmitted="OnFolderSubmitted" SelectionChanged="OnFolderSelected" />
              </StackPanel>
            </Grid>

            <StackPanel x:Name="SqliteFields" Spacing="6">
              <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.file" />
              <TextBox x:Name="FileBox" Style="{StaticResource FieldBoxStyle}" TextChanged="OnFileChanged" />
            </StackPanel>

            <StackPanel x:Name="ServerFields" Spacing="14">
              <Grid ColumnDefinitions="*,16,220">
                <StackPanel Spacing="6">
                  <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.host" />
                  <TextBox x:Name="HostBox" Style="{StaticResource FieldBoxStyle}" TextChanged="OnHostChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.port" />
                  <TextBox x:Name="PortBox" Style="{StaticResource FieldBoxStyle}" TextChanged="OnPortChanged" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.database" />
                <TextBox x:Name="DatabaseBox" Style="{StaticResource FieldBoxStyle}" TextChanged="OnDatabaseChanged" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.user" />
                <TextBox x:Name="UserBox" Style="{StaticResource FieldBoxStyle}" TextChanged="OnUserChanged" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.password" />
                <PasswordBox x:Name="PasswordInput" MinHeight="30" PasswordChanged="OnPasswordChanged" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="SshTab" Grid.Row="5" Spacing="14" Margin="0,16,0,0" Visibility="Collapsed">
            <CheckBox x:Name="UseSshBox" Click="OnUseSshClicked" loc:Loc.Key="connections.useSsh" />
            <StackPanel x:Name="SshFields" Spacing="14">
              <Grid ColumnDefinitions="*,16,220">
                <StackPanel Spacing="6">
                  <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.sshHost" />
                  <TextBox x:Name="SshHostBox" Style="{StaticResource FieldBoxStyle}" TextChanged="OnSshHostChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.sshPort" />
                  <TextBox x:Name="SshPortBox" Style="{StaticResource FieldBoxStyle}" TextChanged="OnSshPortChanged" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,16,220">
                <StackPanel Spacing="6">
                  <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.sshUser" />
                  <TextBox x:Name="SshUserBox" Style="{StaticResource FieldBoxStyle}" TextChanged="OnSshUserChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.authentication" />
                  <ComboBox x:Name="SshAuthBox" HorizontalAlignment="Stretch" MinHeight="30" SelectionChanged="OnSshAuthChanged" />
                </StackPanel>
              </Grid>
              <StackPanel x:Name="SshKeyFields" Spacing="6">
                <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.sshKeyFile" />
                <TextBox x:Name="SshKeyBox" Style="{StaticResource FieldBoxStyle}" TextChanged="OnSshKeyChanged" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource FieldLabelStyle}" loc:Loc.Key="connections.sshSecret" />
                <PasswordBox x:Name="SshSecretInput" MinHeight="30" PasswordChanged="OnSshSecretChanged" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <Border x:Name="SshCard" Grid.Row="5" Grid.Column="2" Margin="0,16,0,0" VerticalAlignment="Top" Padding="14" CornerRadius="{StaticResource SquillRadiusLg}"
                  Background="{ThemeResource SquillBgRaisedBrush}" BorderBrush="{ThemeResource SquillBorderSubtleBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock FontSize="{StaticResource SquillFontSizeBody}" FontWeight="SemiBold" Foreground="{ThemeResource SquillFgBrush}" VerticalAlignment="Center"
                           loc:Loc.Key="connections.sshTunnel" />
                <ContentControl Grid.Column="1" Style="{StaticResource BadgeSuccessStyle}" Margin="8,0,0,0" VerticalAlignment="Center" loc:Loc.Key="connections.enabled" />
                <Button Grid.Column="3" Style="{StaticResource GhostButtonStyle}" MinHeight="0" Padding="4,0" Foreground="{ThemeResource SquillAccentTextBrush}"
                        Click="OnEditSsh" loc:Loc.Key="connections.edit" />
              </Grid>
              <TextBlock x:Name="SshSummary" Style="{StaticResource MonoTextBlockStyle}" FontSize="{StaticResource SquillFontSizeBodySm}"
                         Foreground="{ThemeResource SquillFg2Brush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>

          <TextBlock x:Name="ErrorsText" Grid.Row="6" Grid.ColumnSpan="3" Margin="0,16,0,0" Foreground="{ThemeResource SquillDangerBrush}" TextWrapping="Wrap" />
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="1" Height="60" Background="{ThemeResource SquillBgSurfaceBrush}" BorderBrush="{ThemeResource SquillBorderSubtleBrush}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto" Margin="32,0">
          <Border x:Name="ResultBar" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="14,8" CornerRadius="{StaticResource SquillRadiusMd}" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock x:Name="ResultText" FontSize="{StaticResource SquillFontSizeBody}" FontWeight="SemiBold" />
              <TextBlock x:Name="ResultDetail" Style="{StaticResource MonoTextBlockStyle}" FontSize="{StaticResource SquillFontSizeBodySm}" Foreground="{ThemeResource SquillFg2Brush}" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="TestButton">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock loc:Loc.Key="connections.test" />
                <ContentControl Style="{StaticResource KeyboardChipStyle}" Content="Ctrl+Entrée" />
              </StackPanel>
            </Button>
            <Button Click="OnCancel" loc:Loc.Key="connections.cancel" />
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}" loc:Loc.Key="connections.save" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
