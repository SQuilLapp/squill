<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="using:Squill.Presentation.Home"
             xmlns:core="using:Squill.Core"
             xmlns:controls="using:Squill.App.Avalonia.Controls"
             xmlns:loc="using:Squill.App.Avalonia.Localization"
             x:Class="Squill.App.Avalonia.Views.HomePage"
             x:DataType="h:HomeViewModel">
  <UserControl.Styles>
    <Style Selector="Border.envbar"><Setter Property="Background" Value="{DynamicResource SquillBorderBrush}" /></Style>
    <Style Selector="Border.envbar.env-prod"><Setter Property="Background" Value="{DynamicResource SquillEnvProdBrush}" /></Style>
    <Style Selector="Border.envbar.env-staging"><Setter Property="Background" Value="{DynamicResource SquillEnvStagingBrush}" /></Style>
    <Style Selector="Border.envbar.env-dev"><Setter Property="Background" Value="{DynamicResource SquillEnvDevBrush}" /></Style>
    <Style Selector="Border.envbar.env-local"><Setter Property="Background" Value="{DynamicResource SquillEnvLocalBrush}" /></Style>
    <Style Selector="Button.card">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SquillBorderSubtleBrush}" />
      <Setter Property="Background" Value="{DynamicResource SquillBgRaisedBrush}" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SquillBgHoverBrush}" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SquillAccentTextBrush}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource SquillBgBaseBrush}">
    <Grid MaxWidth="1000" Margin="40,40,40,32" ColumnDefinitions="*,300" RowDefinitions="Auto,Auto" ColumnSpacing="32" RowSpacing="28">
      <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,360">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Image Source="avares://Squill.App.Avalonia/Assets/squill-32.png" Width="32" Height="32" VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Name="Wordmark" Text="SQuilL" FontFamily="{DynamicResource SquillFontBrand}" FontSize="{DynamicResource SquillFontSizeDisplay}"
                       FontWeight="Bold" Foreground="{DynamicResource SquillFgBrush}" />
            <TextBlock Name="VersionText" Foreground="{DynamicResource SquillFg2Brush}" />
          </StackPanel>
        </StackPanel>
        <Button Name="SearchButton" Grid.Column="2" Height="34" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
                Padding="12,0,10,0" CornerRadius="6" Command="{Binding SearchCommand}" Background="{DynamicResource SquillBgRaisedBrush}"
                BorderBrush="{DynamicResource SquillBorderBrush}" AutomationProperties.Name="{loc:Text search.placeholder}">
          <DockPanel>
            <Border DockPanel.Dock="Right" Classes="kbd"><TextBlock Text="Ctrl+K" /></Border>
            <Path DockPanel.Dock="Left" Classes="icon" Width="14" Height="14" Margin="0,0,8,0" Data="{StaticResource SquillIconSearch}"
                  Stroke="{DynamicResource SquillFg3Brush}" />
            <TextBlock Text="{loc:Text search.placeholder}" Foreground="{DynamicResource SquillFg3Brush}" VerticalAlignment="Center" />
          </DockPanel>
        </Button>
      </Grid>
      <StackPanel Grid.Row="1" Spacing="12">
        <Grid>
          <TextBlock Classes="caps" Text="{loc:Text home.recent}" VerticalAlignment="Center" />
          <Button Classes="link" Content="{loc:Text home.manageConnections}" HorizontalAlignment="Right" Command="{Binding ManageConnectionsCommand}" />
        </Grid>
        <TextBlock Name="EmptyText" Text="{loc:Text home.noConnection}" Foreground="{DynamicResource SquillFg2Brush}" />
        <ItemsControl Name="Cards" ItemsSource="{Binding RecentCards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="h:HomeRecentCardViewModel">
              <Button Classes="card" Margin="0,0,12,12" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Height="3" CornerRadius="8,8,0,0" Classes="envbar"
                          Classes.env-prod="{Binding Environment, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:ConnectionEnvironment.Production}}"
                          Classes.env-staging="{Binding Environment, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:ConnectionEnvironment.Staging}}"
                          Classes.env-dev="{Binding Environment, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:ConnectionEnvironment.Development}}"
                          Classes.env-local="{Binding Environment, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:ConnectionEnvironment.Local}}" />
                  <StackPanel Spacing="10" Margin="16,14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <controls:EngineIcon Width="18" Height="18" Dialect="{Binding Profile.Dialect}" MariaDb="{Binding Profile.MariaDb}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource SquillFontSizeSubtitle}"
                                   Foreground="{DynamicResource SquillFgBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Classes="badge" IsVisible="{Binding EnvironmentText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Classes.env-prod="{Binding Environment, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:ConnectionEnvironment.Production}}"
                                Classes.env-staging="{Binding Environment, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:ConnectionEnvironment.Staging}}"
                                Classes.env-dev="{Binding Environment, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:ConnectionEnvironment.Development}}"
                                Classes.env-local="{Binding Environment, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:ConnectionEnvironment.Local}}">
                          <TextBlock Text="{Binding EnvironmentText}" />
                        </Border>
                      </StackPanel>
                      <Border Grid.Column="2" Classes="kbd"><TextBlock Text="{Binding Shortcut}" /></Border>
                    </Grid>
                    <TextBlock Classes="mono" Text="{Binding Subtitle}" FontSize="{DynamicResource SquillFontSizeBodySm}"
                               Foreground="{DynamicResource SquillFg2Brush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LastOpened}" FontSize="{DynamicResource SquillFontSizeBodySm}" Foreground="{DynamicResource SquillFg3Brush}" />
                  </StackPanel>
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="16">
        <TextBlock Classes="caps" Text="{loc:Text home.start}" />
        <Button Name="NewConnectionButton" Classes="link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8"
                Command="{Binding NewConnectionCommand}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource SquillAccentBrush}" VerticalAlignment="Top">
              <Path Classes="icon" Width="16" Height="16" Data="{StaticResource SquillIconPlus}" Stroke="{DynamicResource SquillOnAccentBrush}" />
            </Border>
            <TextBlock Grid.Column="1" Text="{loc:Text home.newConnection}" FontWeight="SemiBold" Foreground="{DynamicResource SquillFgBrush}" VerticalAlignment="Center" />
            <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Ctrl+N" /></Border>
          </Grid>
        </Button>
        <Border Name="TipCard" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SquillBorderSubtleBrush}"
                Background="{DynamicResource SquillBgRaisedBrush}" IsVisible="{Binding !TipsHidden}">
          <StackPanel Spacing="10">
            <Grid>
              <TextBlock Classes="caps" Text="{loc:Text home.tip}" />
              <TextBlock Text="{Binding TipPosition}" Foreground="{DynamicResource SquillFg3Brush}" HorizontalAlignment="Right" />
            </Grid>
            <ItemsControl Name="TipText" ItemsSource="{Binding TipSegments}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="h:TipSegment">
                  <Panel>
                    <Border Classes="kbd" Margin="2,0" IsVisible="{Binding IsKey}"><TextBlock Text="{Binding Text}" /></Border>
                    <TextBlock Text="{Binding Text}" Foreground="{DynamicResource SquillFgBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsKey}" />
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid>
              <Button Classes="link" Content="{loc:Text home.tip.next}" Command="{Binding NextTipCommand}" />
              <Button Classes="link" Content="{loc:Text home.tip.hide}" HorizontalAlignment="Right" Command="{Binding HideTipsCommand}" />
            </Grid>
          </StackPanel>
        </Border>
        <CheckBox Name="StartupCheck" Content="{loc:Text home.showAtStartup}" IsChecked="{Binding ShowAtStartup}" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
