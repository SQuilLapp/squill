<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ws="using:Squill.Presentation.Workspace"
             xmlns:core="using:Squill.Core"
             xmlns:v="using:Squill.App.Avalonia.Views"
             x:Class="Squill.App.Avalonia.Views.SidebarView"
             x:DataType="ws:WorkspaceViewModel">
  <Grid RowDefinitions="Auto,*,Auto,2*" Background="{DynamicResource SquillBgSurfaceBrush}">
    <TextBlock Text="Connections" Margin="8,6" FontWeight="SemiBold" Foreground="{DynamicResource SquillFgBrush}" />
    <ListBox Grid.Row="1" Name="Profiles" ItemsSource="{Binding ConnectionList.Profiles}"
             SelectedItem="{Binding ConnectionList.SelectedProfile, Mode=TwoWay}" Background="Transparent"
             DoubleTapped="OnProfileDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="core:ConnectionProfile">
          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SquillFgBrush}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Text="Objects" Margin="8,6" FontWeight="SemiBold" Foreground="{DynamicResource SquillFgBrush}" />
    <v:ObjectExplorerView Grid.Row="3" DataContext="{Binding Explorer}" />
  </Grid>
</UserControl>
