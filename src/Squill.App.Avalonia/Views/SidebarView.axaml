<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ws="using:Squill.Presentation.Workspace"
             xmlns:v="using:Squill.App.Avalonia.Views"
             xmlns:loc="using:Squill.App.Avalonia.Localization"
             x:Class="Squill.App.Avalonia.Views.SidebarView"
             x:DataType="ws:WorkspaceViewModel">
  <Grid Background="{DynamicResource SquillBgSurfaceBrush}">
    <v:HistoryView Name="HistoryPanel" IsVisible="False" />
    <v:SnippetsView Name="SnippetsPanel" IsVisible="False" />
    <Grid Name="ExplorerPanel" RowDefinitions="36,*">
      <DockPanel Margin="14,0,8,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Name="NewConnectionButton" Classes="ghost" Width="24" Height="24" MinHeight="24" Padding="0"
                  ToolTip.Tip="{loc:Text explorer.newConnection}" Command="{Binding ConnectionList.NewCommand}">
            <Path Classes="icon" Width="14" Height="14" Data="{StaticResource SquillIconPlus}" />
          </Button>
          <Button Name="RefreshButton" Classes="ghost" Width="24" Height="24" MinHeight="24" Padding="0"
                  ToolTip.Tip="{loc:Text explorer.refresh}" Command="{Binding Explorer.RefreshCommand}">
            <Path Classes="icon" Width="14" Height="14" Data="{StaticResource SquillIconRefresh}" />
          </Button>
          <Button Name="CollapseButton" Classes="ghost" Width="24" Height="24" MinHeight="24" Padding="0"
                  ToolTip.Tip="{loc:Text explorer.collapseAll}" Click="OnCollapseAllClicked">
            <Path Classes="icon" Width="14" Height="14" Data="{StaticResource SquillIconCollapse}" />
          </Button>
        </StackPanel>
        <TextBlock Classes="caps" Text="{loc:Text explorer.title}" VerticalAlignment="Center" />
      </DockPanel>
      <v:ObjectExplorerView Grid.Row="1" Name="ObjectExplorer" DataContext="{Binding Explorer}" />
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="0,12"
                  IsVisible="{Binding !ConnectionList.Profiles.Count}">
        <TextBlock Text="No connections yet" Foreground="{DynamicResource SquillFg3Brush}" />
        <Button Content="New connection" HorizontalAlignment="Center" Command="{Binding ConnectionList.NewCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
