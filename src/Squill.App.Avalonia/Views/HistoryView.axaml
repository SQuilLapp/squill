<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pn="using:Squill.Presentation.Panels"
             xmlns:st="using:Squill.Platform.Storage"
             xmlns:v="using:Squill.App.Avalonia.Views"
             xmlns:loc="using:Squill.App.Avalonia.Localization"
             x:Class="Squill.App.Avalonia.Views.HistoryView"
             x:DataType="pn:HistoryViewModel">
  <UserControl.Styles>
    <Style Selector="Ellipse.ok"><Setter Property="Fill" Value="{DynamicResource SquillSuccessBrush}" /></Style>
    <Style Selector="Ellipse.failed"><Setter Property="Fill" Value="{DynamicResource SquillDangerBrush}" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="8">
      <TextBox Name="FilterBox" FontSize="12" Height="27" MinHeight="27" PlaceholderText="{loc:Text editor.historySearch}"
               Text="{Binding FilterText, Mode=TwoWay}" />
      <Button Grid.Column="1" Classes="ghost" Margin="4,0,0,0" Padding="8,0" Height="27" MinHeight="27" Content="{loc:Text editor.historyClear}"
              Command="{Binding ClearCommand}" />
    </Grid>
    <ListBox Grid.Row="1" Name="List" ItemsSource="{Binding Entries}" Background="Transparent" DoubleTapped="OnDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="st:HistoryEntry">
          <StackPanel Spacing="3" Margin="0,4">
            <TextBlock Classes="mono" FontSize="12" Text="{Binding Sql}" MaxLines="2" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource SquillFgBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center" Classes.ok="{Binding Succeeded}" Classes.failed="{Binding !Succeeded}" />
              <TextBlock FontSize="12" Text="{Binding Converter={x:Static v:HistoryFormat.DetailConverter}}"
                         Foreground="{DynamicResource SquillFg3Brush}" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
