<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Squill.App.Avalonia.Localization"
             x:Class="Squill.App.Avalonia.Views.FilterBar"
             Height="36" IsVisible="False">
  <Border Padding="8,0" Background="{DynamicResource SquillBgBaseBrush}"
          BorderBrush="{DynamicResource SquillBorderSubtleBrush}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <StackPanel Name="Chips" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
          <Button Name="AddFilter" Height="26" MinHeight="26" Padding="10,0" VerticalAlignment="Center"
                  Content="{loc:Text results.filter.add}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnFlyoutOpening" Closed="OnFlyoutClosed" />
            </Button.Flyout>
          </Button>
        </StackPanel>
      </ScrollViewer>
      <TextBox Name="Search" Grid.Column="1" Width="220" Height="27" MinHeight="27" Padding="4,3" VerticalAlignment="Center"
               VerticalContentAlignment="Center" PlaceholderText="{loc:Text results.filter.search.placeholder}">
        <TextBox.InnerLeftContent>
          <Path Classes="icon" Width="13" Height="13" Margin="9,0,0,0" IsHitTestVisible="False"
                Stroke="{DynamicResource SquillFg3Brush}" Data="{StaticResource SquillIconSearch}" />
        </TextBox.InnerLeftContent>
        <TextBox.InnerRightContent>
          <Panel>
            <Border Name="Shortcut" Classes="kbd" Margin="0,0,8,0" IsHitTestVisible="False">
              <TextBlock Text="Ctrl+F" />
            </Border>
            <Button Name="ClearSearch" Classes="icon" Width="22" Height="22" MinHeight="22" Padding="0" Margin="0,0,3,0"
                    IsVisible="False" ToolTip.Tip="{loc:Text results.filter.clear}">
              <Path Classes="icon" Width="10" Height="10" Data="{StaticResource SquillIconClose}" />
            </Button>
          </Panel>
        </TextBox.InnerRightContent>
      </TextBox>
    </Grid>
  </Border>
</UserControl>
