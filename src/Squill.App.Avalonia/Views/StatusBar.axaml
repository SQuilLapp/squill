<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ws="using:Squill.Presentation.Workspace"
             x:Class="Squill.App.Avalonia.Views.StatusBar"
             x:DataType="ws:WorkspaceViewModel">
  <Border Background="{DynamicResource SquillBgSurfaceBrush}" BorderBrush="{DynamicResource SquillBorderSubtleBrush}"
          BorderThickness="0,1,0,0" Padding="8,2" MinHeight="{DynamicResource SquillControlHeightCompact}">
    <DockPanel>
      <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="0" Content="Data folder" Background="Transparent"
              Foreground="{DynamicResource SquillFg2Brush}" Click="OnOpenDataFolder" />
      <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{DynamicResource SquillFgDisabledBrush}"
                 Text="{Binding ActiveTab.Elapsed, StringFormat='{}{0:m\\:ss\\.fff}'}" />
      <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{DynamicResource SquillFgBrush}"
                 Text="{Binding ActiveTab.StatusText}" />
      <TextBlock DockPanel.Dock="Left" Margin="0,0,12,0" Foreground="{DynamicResource SquillFgBrush}"
                 Text="{Binding ActiveSession.Profile.Name, FallbackValue='Not connected'}" />
      <TextBlock Foreground="{DynamicResource SquillFgDisabledBrush}" TextTrimming="CharacterEllipsis"
                 Text="{Binding ActiveSession.Connection.ServerVersion}" />
    </DockPanel>
  </Border>
</UserControl>
