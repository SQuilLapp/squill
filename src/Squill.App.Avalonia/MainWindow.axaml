<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ws="using:Squill.Presentation.Workspace"
        xmlns:q="using:Squill.Presentation.Query"
        xmlns:t="using:Squill.Presentation.Terminal"
        xmlns:dg="using:Squill.Presentation.Diagram"
        xmlns:dz="using:Squill.Presentation.Designer"
        xmlns:v="using:Squill.App.Avalonia.Views"
        xmlns:loc="using:Squill.App.Avalonia.Localization"
        x:Class="Squill.App.Avalonia.MainWindow"
        x:DataType="ws:WorkspaceViewModel"
        Title="" Width="1440" Height="900" MinWidth="720" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="41"
        Icon="avares://Squill.App.Avalonia/Assets/squill.ico"
        Background="{DynamicResource SquillBgBaseBrush}">
  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding ActiveTab.RunCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ActiveTab.RunCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding ActiveTab.CancelCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding ActiveTab.FormatDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding NewTabCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding ActiveDesigner.ApplyCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" CommandParameter="{Binding ActiveTab}" />
  </Window.KeyBindings>
  <Window.Styles>
    <Style Selector="Menu > MenuItem">
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource SquillFgBrush}" />
    </Style>
    <Style Selector="RadioButton.rail">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="RadioButton.rail /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="RadioButton.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SquillBgHoverBrush}" />
    </Style>
    <Style Selector="RadioButton.rail:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SquillAccentSoftBrush}" />
    </Style>
    <Style Selector="RadioButton.rail:checked Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource SquillAccentBrush}" />
    </Style>
    <Style Selector="ListBox.tabstrip ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="35" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.tabstrip ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tabstrip ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tabstrip ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tabstrip ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.tab:pointerover">
      <Setter Property="Background" Value="{DynamicResource SquillBgHoverBrush}" />
    </Style>
    <Style Selector="Border.tab.active">
      <Setter Property="Background" Value="{DynamicResource SquillBgBaseBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SquillAccentBrush}" />
    </Style>
    <Style Selector="Border.tab.active.env-prod"><Setter Property="BorderBrush" Value="{DynamicResource SquillEnvProdBrush}" /></Style>
    <Style Selector="Border.tab.active.env-staging"><Setter Property="BorderBrush" Value="{DynamicResource SquillEnvStagingBrush}" /></Style>
    <Style Selector="Border.tab.active.env-dev"><Setter Property="BorderBrush" Value="{DynamicResource SquillEnvDevBrush}" /></Style>
    <Style Selector="Border.tab.active.env-local"><Setter Property="BorderBrush" Value="{DynamicResource SquillEnvLocalBrush}" /></Style>
    <Style Selector="Border.tab Border.envsquare"><Setter Property="Background" Value="{DynamicResource SquillFg3Brush}" /></Style>
    <Style Selector="Border.tab.env-prod Border.envsquare"><Setter Property="Background" Value="{DynamicResource SquillEnvProdBrush}" /></Style>
    <Style Selector="Border.tab.env-staging Border.envsquare"><Setter Property="Background" Value="{DynamicResource SquillEnvStagingBrush}" /></Style>
    <Style Selector="Border.tab.env-dev Border.envsquare"><Setter Property="Background" Value="{DynamicResource SquillEnvDevBrush}" /></Style>
    <Style Selector="Border.tab.env-local Border.envsquare"><Setter Property="Background" Value="{DynamicResource SquillEnvLocalBrush}" /></Style>
    <Style Selector="Border.tab Button.close"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="Border.tab:pointerover Button.close"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Border.tab.active Button.close"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Button.rail">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="41,*,Auto" ColumnDefinitions="45,270,Auto,*,Auto">
    <Border Name="TitleBar" Grid.ColumnSpan="5" Background="{DynamicResource SquillBgBaseBrush}"
            BorderBrush="{DynamicResource SquillBorderSubtleBrush}" BorderThickness="0,0,0,1">
      <Grid Name="TitleGrid" ColumnDefinitions="Auto,*,0">
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
          <Image Source="avares://Squill.App.Avalonia/Assets/squill-32.png" Width="16" Height="16" Margin="0,0,8,0" />
          <Button Name="HamburgerButton" IsVisible="False" Width="32" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                  VerticalAlignment="Center" ToolTip.Tip="{loc:Text menu.main}">
            <Path Data="M3,6 H21 M3,12 H21 M3,18 H21" Width="14" Height="14" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round"
                  Stroke="{DynamicResource SquillFgBrush}" />
          </Button>
          <Menu Name="MainMenu" VerticalAlignment="Center" FontSize="13">
            <MenuItem Header="{loc:Text menu.file}">
              <MenuItem Header="{loc:Text menu.newTab}" InputGesture="Ctrl+T" Command="{Binding NewTabCommand}" />
              <MenuItem Header="{loc:Text menu.closeTab}" InputGesture="Ctrl+W" Command="{Binding CloseTabCommand}"
                        CommandParameter="{Binding ActiveTab}" />
              <Separator />
              <MenuItem Name="SettingsMenuItem" Header="{loc:Text menu.settings}" InputGesture="Ctrl+," Click="OnSettingsClicked" />
              <MenuItem Name="DataFolderMenuItem" Header="{loc:Text menu.openDataFolder}" Click="OnOpenDataFolder" />
            </MenuItem>
            <MenuItem Header="{loc:Text menu.edit}">
              <MenuItem Header="{loc:Text menu.undo}" IsEnabled="False" />
              <MenuItem Header="{loc:Text menu.redo}" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="{loc:Text menu.view}">
              <MenuItem Header="{loc:Text menu.erDiagram}" Command="{Binding OpenDiagramCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Text menu.query}">
              <MenuItem Header="{loc:Text editor.run}" InputGesture="Ctrl+Enter" Command="{Binding ActiveTab.RunCommand}" />
              <MenuItem Header="{loc:Text menu.runScript}" Command="{Binding ActiveTab.RunAllCommand}" />
              <MenuItem Header="{loc:Text editor.stop}" InputGesture="Escape" Command="{Binding ActiveTab.CancelCommand}" />
              <Separator />
              <MenuItem Header="{loc:Text menu.format}" InputGesture="Ctrl+Shift+F" Command="{Binding ActiveTab.FormatDocumentCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Text menu.database}">
              <MenuItem Header="{loc:Text menu.newTable}" Command="{Binding NewTableCommand}" />
            </MenuItem>
            <MenuItem Name="ToolsMenu" Header="{loc:Text menu.tools}">
              <MenuItem Header="{loc:Text menu.settings}" Click="OnSettingsClicked" />
            </MenuItem>
            <MenuItem Header="{loc:Text menu.help}">
              <MenuItem Header="{loc:Text menu.about}" IsEnabled="False" />
            </MenuItem>
          </Menu>
        </StackPanel>
        <!-- Placeholder for the command palette, which does not exist yet. -->
        <Border Name="CommandSearch" Grid.Column="1" MaxWidth="438" MinWidth="80" Height="27" CornerRadius="6" IsEnabled="False" IsHitTestVisible="False"
                Margin="12,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource SquillBgRaisedBrush}"
                BorderBrush="{DynamicResource SquillBorderBrush}" BorderThickness="1" Padding="8,0">
          <DockPanel>
            <Border DockPanel.Dock="Right" Classes="kbd"><TextBlock Text="Ctrl+K" /></Border>
            <Path DockPanel.Dock="Left" Classes="icon" Width="14" Height="14" Margin="0,0,8,0" Data="{StaticResource SquillIconSearch}"
                  Stroke="{DynamicResource SquillFg3Brush}" />
            <TextBlock Text="{loc:Text search.placeholder}" Foreground="{DynamicResource SquillFg3Brush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
      </Grid>
    </Border>
    <Border Name="ActivityRail" Grid.Row="1" Background="{DynamicResource SquillBgSurfaceBrush}"
            BorderBrush="{DynamicResource SquillBorderSubtleBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Button DockPanel.Dock="Bottom" Name="RailSettings" Classes="rail ghost" Margin="0,0,0,8" HorizontalAlignment="Center"
                ToolTip.Tip="{loc:Text menu.settings}" Click="OnSettingsClicked">
          <Path Classes="icon" Data="{StaticResource SquillIconSettings}" />
        </Button>
        <StackPanel Spacing="4" Margin="0,8,0,0">
          <Grid>
            <Border Width="3" Height="24" HorizontalAlignment="Left" CornerRadius="0,2,2,0" Background="{DynamicResource SquillAccentBrush}"
                    IsVisible="{Binding #RailExplorer.IsChecked}" />
            <RadioButton Name="RailExplorer" Classes="rail" GroupName="SidebarPanel" Theme="{StaticResource {x:Type ToggleButton}}"
                         IsChecked="True" ToolTip.Tip="{loc:Text rail.explorer}" IsCheckedChanged="OnRailChecked">
              <Path Classes="icon" Data="{StaticResource SquillIconExplorer}" />
            </RadioButton>
          </Grid>
          <Grid>
            <Border Width="3" Height="24" HorizontalAlignment="Left" CornerRadius="0,2,2,0" Background="{DynamicResource SquillAccentBrush}"
                    IsVisible="{Binding #RailHistory.IsChecked}" />
            <RadioButton Name="RailHistory" Classes="rail" GroupName="SidebarPanel" Theme="{StaticResource {x:Type ToggleButton}}"
                         ToolTip.Tip="{loc:Text editor.history}" IsCheckedChanged="OnRailChecked">
              <Path Classes="icon" Data="{StaticResource SquillIconHistory}" />
            </RadioButton>
          </Grid>
          <Grid>
            <Border Width="3" Height="24" HorizontalAlignment="Left" CornerRadius="0,2,2,0" Background="{DynamicResource SquillAccentBrush}"
                    IsVisible="{Binding #RailSnippets.IsChecked}" />
            <RadioButton Name="RailSnippets" Classes="rail" GroupName="SidebarPanel" Theme="{StaticResource {x:Type ToggleButton}}"
                         ToolTip.Tip="{loc:Text editor.snippets}" IsCheckedChanged="OnRailChecked">
              <Path Classes="icon" Data="{StaticResource SquillIconSnippets}" />
            </RadioButton>
          </Grid>
          <Button Name="RailDiagram" Classes="rail ghost" HorizontalAlignment="Center" ToolTip.Tip="{loc:Text menu.erDiagram}"
                  Command="{Binding OpenDiagramCommand}">
            <Path Classes="icon" Data="{StaticResource SquillIconDiagram}" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <v:SidebarView Grid.Row="1" Grid.Column="1" Name="Sidebar" />
    <GridSplitter Grid.Row="1" Grid.Column="2" Width="4" Background="{DynamicResource SquillBorderBrush}" />
    <Grid Grid.Row="1" Grid.Column="3" RowDefinitions="Auto,*">
      <Border Name="TabStripBar" Background="{DynamicResource SquillBgSurfaceBrush}" Height="36"
              BorderBrush="{DynamicResource SquillBorderSubtleBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
          <Button DockPanel.Dock="Right" Name="NewTabButton" Classes="ghost" Width="36" Padding="0" CornerRadius="0"
                  ToolTip.Tip="{loc:Text menu.newTab}" Command="{Binding NewTabCommand}">
            <Path Classes="icon" Width="14" Height="14" Data="{StaticResource SquillIconPlus}" />
          </Button>
          <ListBox Name="TabStrip" Classes="tabstrip" Background="Transparent" Padding="0" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="v:WorkspaceTab">
                <Border BorderBrush="{DynamicResource SquillBorderSubtleBrush}" BorderThickness="0,0,1,0">
                  <Border Classes="tab" Classes.active="{Binding $parent[ListBoxItem].IsSelected}" Classes.env-prod="{Binding IsProd}"
                          Classes.env-staging="{Binding IsStaging}" Classes.env-dev="{Binding IsDev}" Classes.env-local="{Binding IsLocal}"
                          BorderThickness="0,2,0,0" Padding="12,0,6,0" Height="35">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Border Classes="envsquare" Width="8" Height="8" CornerRadius="2" />
                      <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource SquillFgBrush}" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource SquillFg3Brush}" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" />
                      <Button Classes="ghost close" Width="20" Height="20" MinHeight="20" Padding="0" CornerRadius="4" Click="OnCloseTabClicked">
                        <Path Classes="icon" Width="10" Height="10" Data="{StaticResource SquillIconClose}" />
                      </Button>
                    </StackPanel>
                  </Border>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <v:QueryTabView Grid.Row="1" Name="ActiveTabView" DataContext="{Binding ActiveTab}" />
      <v:DiagramTabView Grid.Row="1" Name="DiagramArea" IsVisible="False" />
      <v:TableDesignerView Grid.Row="1" Name="DesignerArea" IsVisible="False" />
      <Grid Name="TerminalArea" Grid.Row="1" IsVisible="False" Background="{DynamicResource SquillBgBaseBrush}" />
    </Grid>
    <v:PropertiesPanel Grid.Row="1" Grid.Column="4" Name="Properties" />
    <v:StatusBar Grid.Row="2" Name="Status" Grid.ColumnSpan="5" />
  </Grid>
</Window>
