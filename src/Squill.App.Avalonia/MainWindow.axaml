<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ws="using:Squill.Presentation.Workspace"
        xmlns:q="using:Squill.Presentation.Query"
        xmlns:v="using:Squill.App.Avalonia.Views"
        x:Class="Squill.App.Avalonia.MainWindow"
        x:DataType="ws:WorkspaceViewModel"
        Title="SQuilL" Width="1100" Height="700"
        Icon="avares://Squill.App.Avalonia/Assets/squill.ico"
        Background="{DynamicResource SquillBgBaseBrush}">
  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding ActiveTab.RunCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ActiveTab.RunCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding ActiveTab.CancelCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding ActiveTab.FormatDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding NewTabCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" CommandParameter="{Binding ActiveTab}" />
  </Window.KeyBindings>
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="260,Auto,*">
    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="4" Margin="6,4"
                Background="{DynamicResource SquillBgBaseBrush}">
      <Button Content="Run" ToolTip.Tip="F5 / Ctrl+Enter" Command="{Binding ActiveTab.RunCommand}" />
      <Button Content="Run all" Command="{Binding ActiveTab.RunAllCommand}" />
      <Button Content="Cancel" ToolTip.Tip="Esc" Command="{Binding ActiveTab.CancelCommand}"
              IsVisible="{Binding ActiveTab.IsRunning, FallbackValue=False}" />
      <Button Content="Format" ToolTip.Tip="Ctrl+Shift+F" Command="{Binding ActiveTab.FormatDocumentCommand}" />
      <Button Content="New tab" ToolTip.Tip="Ctrl+T" Command="{Binding NewTabCommand}" />
      <Button Content="Settings" ToolTip.Tip="Ctrl+," Click="OnSettingsClicked" />
      <Button Content="Close tab" ToolTip.Tip="Ctrl+W" Command="{Binding CloseTabCommand}"
              CommandParameter="{Binding ActiveTab}" />
    </StackPanel>
    <v:SidebarView Grid.Row="1" Name="Sidebar" />
    <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" Background="{DynamicResource SquillBorderBrush}" />
    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,*">
      <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab, Mode=TwoWay}" Background="Transparent">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="q:QueryTabViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Foreground="{DynamicResource SquillFgBrush}" />
              <Button Content="x" Padding="4,0" Background="Transparent" Click="OnCloseTabClicked" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <v:QueryTabView Grid.Row="1" Name="ActiveTabView" DataContext="{Binding ActiveTab}" />
    </Grid>
    <v:StatusBar Grid.Row="2" Name="Status" Grid.ColumnSpan="3" />
  </Grid>
</Window>
